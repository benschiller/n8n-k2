            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ \"model\": \"IFM/K2-Horizon-375B-A23B\", \"messages\": [ { \"role\": \"user\", \"content\": $json.prompt } ] }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "K2 Horizon",
      "type": "n8n-nodes-base.httpRequest",
