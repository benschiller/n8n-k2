    {
      "parameters": {
        "method": "POST",
        "url": "https://api.ifm.ai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_IFM_API_KEY"
